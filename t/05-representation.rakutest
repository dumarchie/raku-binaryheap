use v6;
use Test;

use BinaryHeap :min-heap;

is min-heap.raku, 'BinaryHeap::MinHeap.new', 'min-heap.raku';

# Assert that values provided in heap order maintain their position
for (1, 2, 3), (1, 3, 2) -> \values {
    my $raku = "BinaryHeap::MinHeap.new{values.raku}";
    my $heap = EVAL $raku;
    is $heap.raku, $raku, "$raku.raku";
}

done-testing;
