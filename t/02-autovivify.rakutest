use Test;
plan 4;

use BinaryHeap <GenHeap MaxHeap MinHeap>;

sub values-ok(\heap, \values, $desc = '.values') {
    is-deeply heap.values, values.Seq, $desc;
}

my \values = 25, 17, 36, 2, 19, 7, 3, 1, 100;
subtest 'Push onto an uninitialized max-heap', {
    my MaxHeap $heap;
    is $heap.raku, 'BinaryHeap::MaxHeap', 'my MaxHeap $heap';
    is $heap.push(|values), $heap, '$heap.push(|values)';
    values-ok $heap, (100, 36, 25, 19, 17, 7, 3, 1, 2);
};

subtest 'Push onto an uninitialized min-heap', {
    my MinHeap $heap;
    is $heap.raku, 'BinaryHeap::MinHeap', 'my MinHeap $heap';
    is $heap.push(|values), $heap, '$heap.push(|values)';
    values-ok $heap, (1, 2, 3, 17, 19, 36, 7, 25, 100);
};

subtest 'Push onto an uninitialized heap with custom comparison', {
    my class NihilistHeap does GenHeap[-> $, $ { Same }] {}
    my NihilistHeap $heap;
    is $heap.raku, 'NihilistHeap',
     'my MaxHeap[-> $, $ { Same }] $heap';

    is $heap.push(|values), $heap, '$heap.push(|values)';
    values-ok $heap, values;
};

subtest 'Replace the top of an uninitialized max-heap', {
    my MaxHeap $heap;
    is $heap.replace(42), Nil, '$heap.replace(new) returns Nil';
    values-ok $heap, (42,);
}
