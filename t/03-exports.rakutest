use Test;
plan 7;

use BinaryHeap <MaxHeap MinHeap &heapsort>;

subtest 'infix eqv', {
    ok MaxHeap eqv MaxHeap.new,
      'MaxHeap eqv MaxHeap.new';
    ok MaxHeap !eqv MinHeap.new,
      'MaxHeap !eqv MinHeap.new';
    ok MaxHeap.new(42) eqv MaxHeap.new(42),
      'MaxHeap.new(42) eqv MaxHeap.new(42)';
    ok MaxHeap.new(42) !eqv MinHeap.new(42),
      'MaxHeap.new(42) !eqv MinHeap.new(42)';
}

# Assert that trying to import unexported symbols throws
throws-like "use BinaryHeap <Foo &heapify>", Exception,
  message => "Trying to import from 'BinaryHeap', but the following "
           ~ "symbols are not exported: Foo, &heapify",
  "can't import symbols that are not exported";

# Assert that &heapsort is accessible via package BinaryHeap
sub is-proto(&got, &expected, $desc = '') {
    is-deeply (&got, |&got.candidates), (&expected, |&expected.candidates),
      $desc;
}

is-proto &heapsort, &BinaryHeap::heapsort,
  'imported &heapsort is an alias for &BinaryHeap::heapsort';

my \values = 25, 17, 36, 2, 19, 7, 3, 1, 100;
subtest 'heapsort', {
    my @array = values;
    is heapsort(@array), @array,
      'heapsort(@array) returns the array';
    is-deeply @array, values.sort.Array,
      'the array elements are sorted in ascending order';
}

subtest 'reverse heapsort', {
    my @array = values;
    is heapsort(@array, :reverse), @array,
      'heapsort(@array, :reverse) returns the array';
    is-deeply @array, values.sort.reverse.Array,
      'the array elements are sorted in descending order';
}

# Note: Raku++ 5.4.1 does not support -(* cmp *)
subtest 'heapsort with custom comparator', {
    my @array = values;
    is heapsort({$^b cmp $^a}, @array), @array,
      'heapsort({$^b cmp $^a}, @array) returns the array';
    is-deeply @array, values.sort.reverse.Array,
      'the array elements are put in descending order';
}

subtest 'reverse heapsort with custom comparator', {
    my @array = values;
    is heapsort({$^b cmp $^a}, @array, :reverse), @array,
      'heapsort({$^b cmp $^a}, @array, :reverse) returns the array';
    is-deeply @array, values.sort.Array,
      'the array elements are put in ascending order';
}
